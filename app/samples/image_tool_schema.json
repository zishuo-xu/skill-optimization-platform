        "script": {"type": "string", "enum": ["scripts/ImageEditorAdaptor.ets"]},
        "request": {"type": "object", "required": ["query"], "additionalProperties": false, "properties": {"query": {"type": "string", "minLength": 1}}},
        "args": {"type": "object", "description": "由对应 reference 参数契约生成的字段；method 与字段组合由 reference 约束。"}
      }
    }
